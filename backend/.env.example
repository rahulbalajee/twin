# Copy to .env and fill in. See README "Local development" for details.

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000

# Bedrock model (inference profile) the twin speaks through
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Optional: region for Bedrock calls (falls back to AWS_REGION, then ap-south-1)
# BEDROCK_REGION=ap-south-1

# Local development stores conversations in ../memory; set true + bucket for S3
USE_S3=false
# S3_BUCKET=twin-dev-memory-<account-id>
